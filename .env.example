# Copy to backend/.env (git-ignored; the app reads .env from the folder you run it in). Never commit real values.
# --- Oracle via ODBC (same pattern as the existing extraction app) ---
ORACLE_ODBC_DSN=YOUR_ODBC_DSN_NAME
# only if the DSN does not already store credentials:
ORACLE_USER=
ORACLE_PASSWORD=
# or a full connection string instead of DSN (secret):
# ORACLE_ODBC_CONNECTION_STRING=
# --- or Oracle via oracledb thin ---
# ORACLE_DSN=host:1521/service
# ORACLE_DRIVER=odbc   # force odbc|oracledb if both are set
DATABASE_URL=postgresql+asyncpg://fpa_app:CHANGE_ME@localhost:5432/fpa
